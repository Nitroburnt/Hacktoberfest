# ---------------------------------------------------------------------------
# AutoEvolve Protocol - environment template. Copy to .env and fill locally.
# NEVER commit .env. Nothing here is a secret in the template.
# ---------------------------------------------------------------------------

# --- LLM (Featherless, OpenAI-compatible) ---------------------------------
FEATHERLESS_API_KEY= rc_a8e7a70cf30c1e2da34787e4b4b13968a70ccac22a1fc1ea655ddcb92d622cf7
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
GENERATOR_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
CRITIC_MODEL=deepseek-ai/DeepSeek-R1
FALLBACK_MODEL=Qwen/Qwen3-32B
# Set to 1 to run the loop with deterministic offline mock responses.
MOCK_LLM=0
# Hard per-run spend ceiling in USD (cost guard).
MAX_COST_USD=10

# --- Worker ---------------------------------------------------------------
WORKER_PORT=8787
WORKER_ORIGIN=http://localhost:8787
WEB_ORIGIN=http://localhost:3000
RUNS_DB_PATH=apps/worker/data/autoevolve.sqlite

# --- Benchmark runner -----------------------------------------------------
# docker | local  (docker is the default; local is a no-network fallback)
BENCHMARK_RUNNER=docker
BENCHMARK_IMAGE=autoevolve-bench
BENCHMARK_TIMEOUT_SEC=5

# --- IPFS / storage -------------------------------------------------------
# local = deterministic content-addressed store in .data/ipfs (no creds needed)
IPFS_PROVIDER=local
STORACHA_KEY=
STORACHA_PROOF=
PINATA_JWT=
IPFS_GATEWAY=https://w3s.link/ipfs

# --- Chain (Base Sepolia, chainId 84532) ----------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
VERIFIER_ADDRESS=
REGISTRY_ADDRESS=
REWARD_WEI=100000000000000
REWARD_ESCROW_FUND_WEI=1000000000000000000
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_WORKER_ORIGIN=http://localhost:8787
NEXT_PUBLIC_BASESCAN_URL=https://sepolia.basescan.org
